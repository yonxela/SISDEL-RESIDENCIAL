rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// SISDEL Comunities - Reglas de seguridad
// Datos aislados por condominio: condominios/{condoId}/...
// El login entrega un token con: role y condominioId.
// Roles: master (todo), admin, policia, vecino, auditor (solo lectura), supervisor (rondas)
// y operador (personal a la medida: arranca sin privilegios).
// El rol, el estado activo y los privilegios se leen SIEMPRE del documento del usuario,
// asi un usuario eliminado, desactivado o con privilegios cambiados lo siente de inmediato.
//
// Privilegios (ver privilegios.js): cada rol trae unos por defecto, y el administrador del
// condominio los amplia o restringe por usuario en usuarios/{id}.privilegios = { clave: true|false }.
// Un usuario sin ese campo conserva exactamente el acceso de su rol. Las funciones pXxx de
// abajo llevan los roles por defecto de cada clave: scripts/test-privilegios.mjs verifica que
// coincidan con el catalogo.
// ═══════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad ──
    function signedIn() { return request.auth != null; }
    function isMaster() { return signedIn() && request.auth.token.get('role', '') == 'master'; }
    function inCondo(condoId) { return signedIn() && request.auth.token.get('condominioId', '') == condoId; }

    function memberDoc(condoId) {
      return get(/databases/$(database)/documents/condominios/$(condoId)/usuarios/$(request.auth.uid)).data;
    }
    function condoDoc(condoId) {
      return get(/databases/$(database)/documents/condominios/$(condoId)).data;
    }

    // Miembro vigente: pertenece al condominio, sigue activo y el condominio tiene servicio
    function isMember(condoId) {
      return inCondo(condoId)
        && condoDoc(condoId).get('active', false) == true
        && memberDoc(condoId).get('active', true) != false;
    }
    function memberRole(condoId) { return memberDoc(condoId).get('role', ''); }
    function isResident(condoId) { return isMember(condoId) && memberRole(condoId) == 'vecino'; }
    // El auditor es de solo lectura: no marca mensajes como leidos ni escribe nada
    function notAuditor(condoId) { return memberRole(condoId) != 'auditor'; }

    // ── Privilegios ──
    // Vale lo que diga el mapa del usuario; si no menciona la clave, el privilegio del rol (roles = quienes
    // lo tienen por defecto)
    function can(condoId, key, roles) {
      return isMember(condoId)
        && memberDoc(condoId).get('privilegios', {}).get(key, memberRole(condoId) in roles) == true;
    }
    // Una accion dentro de un paraguas vale si el usuario no la tiene quitada en su mapa de privilegios
    // (el paraguas se comprueba aparte, en la propia funcion pXxx)
    function childOk(condoId, key) {
      return isMember(condoId)
        && memberDoc(condoId).get('privilegios', {}).get(key, true) == true;
    }
    // Las funciones pXxx (una por clave de privilegios.js que las reglas aplican) se generan con
    // `cd scripts && npm run reglas`; scripts/test-privilegios.mjs verifica que esten al dia.
    // ── BEGIN privilegios generados (scripts/generar-reglas-privilegios.mjs) ──
    // Raiz: lo que diga el mapa del usuario o, si no lo menciona, el rol. Accion: el paraguas activo y la accion no quitada.
    // Usuarios y vecinos
    function pUsuariosVer(c) { return can(c, 'usuarios.ver', ['admin', 'policia', 'supervisor', 'auditor']); }
    function pUsuariosCrear(c) { return can(c, 'usuarios.crear', ['admin']); }
    function pGuardiasCrear(c) { return can(c, 'guardias.crear', ['admin', 'supervisor']); }
    function pUsuariosEditar(c) { return can(c, 'usuarios.editar', ['admin']); }
    function pUsuariosEstado(c) { return pUsuariosEditar(c) && childOk(c, 'usuarios.estado'); }
    function pUsuariosPago(c) { return pUsuariosEditar(c) && childOk(c, 'usuarios.pago'); }
    function pUsuariosEmergencia(c) { return pUsuariosEditar(c) && childOk(c, 'usuarios.emergencia'); }
    function pUsuariosEliminar(c) { return can(c, 'usuarios.eliminar', ['admin']); }
    function pUsuariosCodigos(c) { return can(c, 'usuarios.codigos', ['admin']); }
    function pUsuariosPrivilegios(c) { return can(c, 'usuarios.privilegios', ['admin']); }
    function pPlantillasGestionar(c) { return pUsuariosPrivilegios(c) && childOk(c, 'plantillas.gestionar'); }
    // Mensajes
    function pMensajesRecibir(c) { return can(c, 'mensajes.recibir', ['admin', 'policia', 'supervisor', 'auditor', 'vecino', 'operador']); }
    function pMensajesEnviar(c) { return can(c, 'mensajes.enviar', ['admin']); }
    function pMensajesEliminar(c) { return pMensajesEnviar(c) && childOk(c, 'mensajes.eliminar'); }
    function pMensajesHistorial(c) { return can(c, 'mensajes.historial', ['admin', 'auditor']); }
    // Visitas y vehículos
    function pVisitasVer(c) { return can(c, 'visitas.ver', ['admin', 'policia', 'auditor']); }
    function pVehiculosVer(c) { return pVisitasVer(c) && childOk(c, 'vehiculos.ver'); }
    function pVisitasGestionar(c) { return can(c, 'visitas.gestionar', ['admin']); }
    function pVisitasCrear(c) { return pVisitasGestionar(c) && childOk(c, 'visitas.crear'); }
    function pVisitasEditar(c) { return pVisitasGestionar(c) && childOk(c, 'visitas.editar'); }
    function pVisitasEliminar(c) { return pVisitasGestionar(c) && childOk(c, 'visitas.eliminar'); }
    function pVehiculosCrear(c) { return pVisitasGestionar(c) && childOk(c, 'vehiculos.crear'); }
    function pVehiculosEditar(c) { return pVisitasGestionar(c) && childOk(c, 'vehiculos.editar'); }
    function pVehiculosEliminar(c) { return pVisitasGestionar(c) && childOk(c, 'vehiculos.eliminar'); }
    function pGaritaHistorialBorrar(c) { return pVisitasGestionar(c) && childOk(c, 'garita.historial_borrar'); }
    // Garita y cámara
    function pGaritaOperar(c) { return can(c, 'garita.operar', ['admin', 'policia']); }
    function pGaritaVerificar(c) { return pGaritaOperar(c) && childOk(c, 'garita.verificar'); }
    function pGaritaIngreso(c) { return pGaritaOperar(c) && childOk(c, 'garita.ingreso'); }
    function pGaritaCamara(c) { return can(c, 'garita.camara', ['admin', 'policia', 'auditor']); }
    // Panel del vecino
    function pVecinoVisitas(c) { return can(c, 'vecino.visitas', ['vecino']); }
    function pVecinoTemporal(c) { return pVecinoVisitas(c) && childOk(c, 'vecino.temporal'); }
    function pVecinoHistorial(c) { return can(c, 'vecino.historial', ['vecino']); }
    function pVecinoVehiculos(c) { return can(c, 'vecino.vehiculos', ['vecino']); }
    function pVecinoVehiculosQuitar(c) { return pVecinoVehiculos(c) && childOk(c, 'vecino.vehiculos_quitar'); }
    function pVecinoContactos(c) { return can(c, 'vecino.contactos', ['vecino']); }
    function pPanicoActivar(c) { return can(c, 'panico.activar', ['vecino', 'policia', 'supervisor']); }
    function pPanicoCancelar(c) { return pPanicoActivar(c) && childOk(c, 'panico.cancelar'); }
    // Alertas de pánico
    function pPanicoVer(c) { return can(c, 'panico.ver', ['admin', 'policia', 'supervisor', 'auditor']); }
    function pPanicoContactos(c) { return pPanicoVer(c) && childOk(c, 'panico.contactos'); }
    function pPanicoAtender(c) { return can(c, 'panico.atender', ['admin', 'policia', 'supervisor']); }
    function pPanicoResolver(c) { return pPanicoAtender(c) && childOk(c, 'panico.resolver'); }
    // Sistema Financiero (OIKOS)
    function pFinanzasVer(c) { return can(c, 'finanzas.ver', ['admin', 'auditor']); }
    function pFinanzasUsar(c) { return can(c, 'finanzas.usar', ['admin']); }
    function pFinanzasResidentesCrear(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.residentes_crear'); }
    function pFinanzasResidentesEditar(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.residentes_editar'); }
    function pFinanzasResidentesFiniquitar(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.residentes_finiquitar'); }
    function pFinanzasResidentesEliminar(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.residentes_eliminar'); }
    function pFinanzasCuotasMes(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.cuotas_mes'); }
    function pFinanzasCuotasMeses(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.cuotas_meses'); }
    function pFinanzasCuotasCorregir(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.cuotas_corregir'); }
    function pFinanzasCargosCrear(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.cargos_crear'); }
    function pFinanzasCargosAnular(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.cargos_anular'); }
    function pFinanzasPagosRegistrar(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.pagos_registrar'); }
    function pFinanzasPagosAnular(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.pagos_anular'); }
    function pFinanzasEgresosRegistrar(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.egresos_registrar'); }
    function pFinanzasEgresosAnular(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.egresos_anular'); }
    function pFinanzasConfigGeneral(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.config_general'); }
    function pFinanzasConfigCuota(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.config_cuota'); }
    function pFinanzasConfigConceptos(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.config_conceptos'); }
    function pFinanzasDeshacer(c) { return pFinanzasUsar(c) && childOk(c, 'finanzas.deshacer'); }
    // Rondas de vigilancia (RONDIN)
    function pRondasVer(c) { return can(c, 'rondas.ver', ['admin', 'supervisor', 'auditor']); }
    function pRondasGestionar(c) { return can(c, 'rondas.gestionar', ['admin', 'supervisor']); }
    function pRondasPatrullar(c) { return can(c, 'rondas.patrullar', ['policia', 'supervisor']); }
    function pRondasRutasVer(c) { return pRondasVer(c) && childOk(c, 'rondas.rutas_ver'); }
    function pRondasRutasCrear(c) { return pRondasGestionar(c) && childOk(c, 'rondas.rutas_crear'); }
    function pRondasRutasEliminar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.rutas_eliminar'); }
    function pRondasPuntosCrear(c) { return pRondasGestionar(c) && childOk(c, 'rondas.puntos_crear'); }
    function pRondasPuntosEditar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.puntos_editar'); }
    function pRondasPuntosEliminar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.puntos_eliminar'); }
    function pRondasAsignacionesVer(c) { return pRondasVer(c) && childOk(c, 'rondas.asignaciones_ver'); }
    function pRondasAsignacionesCrear(c) { return pRondasGestionar(c) && childOk(c, 'rondas.asignaciones_crear'); }
    function pRondasAsignacionesEditar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.asignaciones_editar'); }
    function pRondasAsignacionesEliminar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.asignaciones_eliminar'); }
    function pRondasMonitoreoVer(c) { return pRondasVer(c) && childOk(c, 'rondas.monitoreo_ver'); }
    function pRondasMonitoreoHistorial(c) { return pRondasMonitoreoVer(c) && childOk(c, 'rondas.monitoreo_historial'); }
    function pRondasRecorridosVer(c) { return pRondasVer(c) && childOk(c, 'rondas.recorridos_ver'); }
    function pRondasDronesVer(c) { return pRondasVer(c) && childOk(c, 'rondas.drones_ver'); }
    function pRondasDronesOperar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.drones_operar'); }
    function pRondasDronesRegistrar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.drones_registrar'); }
    function pRondasAlertasVer(c) { return pRondasVer(c) && childOk(c, 'rondas.alertas_ver'); }
    function pRondasAlertasAtender(c) { return pRondasGestionar(c) && childOk(c, 'rondas.alertas_atender'); }
    function pRondasAlertasEliminar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.alertas_eliminar'); }
    function pRondasIncidentesVer(c) { return pRondasVer(c) && childOk(c, 'rondas.incidentes_ver'); }
    function pRondasIncidentesResolver(c) { return pRondasGestionar(c) && childOk(c, 'rondas.incidentes_resolver'); }
    function pRondasIncidentesReportar(c) { return pRondasPatrullar(c) && childOk(c, 'rondas.incidentes_reportar'); }
    function pRondasSupervisoresAsignar(c) { return pRondasGestionar(c) && childOk(c, 'rondas.supervisores_asignar'); }
    function pRondasAjustesPanicovecinos(c) { return pRondasGestionar(c) && childOk(c, 'rondas.ajustes_panicovecinos'); }
    function pRondasPatrullaIniciar(c) { return pRondasPatrullar(c) && childOk(c, 'rondas.patrulla_iniciar'); }
    function pRondasPatrullaTerminar(c) { return pRondasPatrullar(c) && childOk(c, 'rondas.patrulla_terminar'); }
    function pRondasPatrullaMarcar(c) { return pRondasPatrullar(c) && childOk(c, 'rondas.patrulla_marcar'); }
    function pRondasPatrullaRastrear(c) { return pRondasPatrullar(c) && childOk(c, 'rondas.patrulla_rastrear'); }
    // ── END privilegios generados ──

    // Rondas: administran quienes tienen rondas.gestionar, patrullan quienes tienen rondas.patrullar,
    // y las alertas de panico las atienden quienes tienen panico.atender
    function canManageRondas(condoId) { return isMaster() || pRondasGestionar(condoId); }
    function isPatroller(condoId) { return pRondasPatrullar(condoId); }
    function isResponder(condoId) { return pPanicoAtender(condoId); }

    function isOwner() { return resource.data.userId == request.auth.uid; }
    function willOwn(condoId) {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.condominioId == condoId;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Quien puede crear un usuario de ese rol. Con usuarios.crear solo se registran vecinos: un guardia lo crea quien
    // tiene guardias.crear, y los demas roles (auditor, supervisor, administrador, operador) exigen ademas asignar
    // privilegios, porque quien crea una cuenta conoce su codigo y entra con ella.
    function canCreateRole(c, role) {
      return (role == 'vecino' && pUsuariosCrear(c))
        || (role == 'policia' && (pGuardiasCrear(c) || (pUsuariosCrear(c) && pUsuariosPrivilegios(c))))
        || (role in ['auditor', 'supervisor', 'admin', 'operador'] && pUsuariosCrear(c) && pUsuariosPrivilegios(c));
    }
    // Editar o borrar a un administrador u operador tambien exige poder asignar privilegios. Solo un administrador o un
    // operador puede tener usuarios.privilegios (lo exige validUser), asi que el rol basta para saber si un usuario "manda"
    function manageable(c, role) {
      return role in ['vecino', 'policia', 'auditor', 'supervisor'] || pUsuariosPrivilegios(c);
    }

    // ── Datos privados del sistema: solo el servidor (Admin SDK) ──
    match /_privado/{document=**} {
      allow read, write: if false;
    }

    // Codigo de un usuario que se crea en la misma escritura (no puede apuntar a un usuario que ya existe)
    function newUserCode() {
      let userPath = /databases/$(database)/documents/condominios/$(request.resource.data.condominioId)/usuarios/$(request.resource.data.userId);
      return !exists(userPath) && getAfter(userPath).data.role == request.resource.data.role;
    }
    // Rol que tendra el usuario al que apunta el codigo, una vez aplicada la escritura
    function codeTargetRole() {
      return getAfter(/databases/$(database)/documents/condominios/$(request.resource.data.condominioId)/usuarios/$(request.resource.data.userId)).data.role;
    }
    // Codigo nuevo: de un usuario que se crea ahora (lo puede quien puede crear ese rol) o de uno que ya existe
    // (reemplazo del codigo: usuarios.codigos, y sobre administradores y operadores solo con usuarios.privilegios)
    function codeCreateOk(c) {
      return request.resource.data.role in ['vecino', 'policia', 'admin', 'auditor', 'supervisor', 'operador']
        && (newUserCode()
            ? canCreateRole(c, request.resource.data.role)
            : (pUsuariosCodigos(c) && manageable(c, codeTargetRole()) && request.resource.data.role == codeTargetRole()));
    }

    // ── Codigos de acceso: indice unico codigo -> usuario ──
    // No se guardan dentro del usuario para que guardias y vecinos no puedan leerlos.
    match /codigos/{code} {
      // Quien ve codigos (usuarios.codigos) no ve los de administradores y operadores salvo que pueda asignar privilegios:
      // con el codigo de un administrador se entra como administrador
      allow read: if isMaster()
        || (pUsuariosCodigos(resource.data.condominioId)
            && (pUsuariosPrivilegios(resource.data.condominioId) || resource.data.role in ['vecino', 'policia', 'auditor', 'supervisor']))
        || (pGuardiasCrear(resource.data.condominioId) && resource.data.role == 'policia');
      allow create: if isMaster() || codeCreateOk(request.resource.data.condominioId);
      // Nunca se sobreescribe: un codigo ocupado rechaza la escritura
      allow update: if false;
      allow delete: if isMaster()
        || ((pUsuariosCodigos(resource.data.condominioId) || pUsuariosEliminar(resource.data.condominioId))
            && manageable(resource.data.condominioId, resource.data.role));
    }

    // ── Mensajes para todos los condominios ──
    match /mensajes_globales/{msgId} {
      allow read: if isMaster() || pMensajesRecibir(request.auth.token.get('condominioId', ''));
      allow create, delete: if isMaster();
      allow update: if isMaster()
        || (pMensajesRecibir(request.auth.token.get('condominioId', ''))
            && notAuditor(request.auth.token.get('condominioId', ''))
            && onlyChanges(['read']));
    }

    // ── Lecturas de camara sin condominio valido ──
    match /camera_logs_huerfanos/{logId} {
      allow read, delete: if isMaster();
      allow create, update: if false;
    }

    // ── Consultas globales del master ──
    match /{path=**}/usuarios/{docId} { allow read: if isMaster(); }
    match /{path=**}/visitas/{docId} { allow read: if isMaster(); }
    match /{path=**}/vehiculos/{docId} { allow read: if isMaster(); }
    match /{path=**}/mensajes/{docId} { allow read: if isMaster(); }
    match /{path=**}/camera_logs/{docId} { allow read: if isMaster(); }

    // ── Condominios ──
    match /condominios/{condoId} {
      allow read: if isMaster() || isMember(condoId);
      allow write: if isMaster();

      // El usuario dueño del documento ya no existira al aplicarse la escritura (borrado en cascada al eliminarlo)
      function ownerGone(ownerId) {
        return !existsAfter(/databases/$(database)/documents/condominios/$(condoId)/usuarios/$(ownerId));
      }

      match /usuarios/{userId} {
        function validUser() {
          return request.resource.data.condominioId == condoId
            && request.resource.data.role in ['vecino', 'policia', 'admin', 'auditor', 'supervisor', 'operador']
            && !('accessCode' in request.resource.data)
            && (!('privilegios' in request.resource.data)
                || (request.resource.data.privilegios is map && request.resource.data.privilegios.size() <= 300
                    && (request.resource.data.privilegios.get('usuarios.privilegios', false) != true
                        || request.resource.data.role in ['admin', 'operador'])));
        }
        // Rol y privilegios son el poder de un usuario: cambiarlos exige usuarios.privilegios
        // y nadie se los cambia a si mismo (solo el master)
        function touchesPower() {
          return request.resource.data.get('privilegios', {}) != resource.data.get('privilegios', {})
            || request.resource.data.role != resource.data.role;
        }
        // Con la mora automatica activa, el estado de pago lo escribe solo el servidor
        // (lo calcula el Sistema Financiero; ver functions/src/finanzas/recalc.js)
        function paymentByHand() {
          return condoDoc(condoId).get('moraAutomatica', false) != true
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus', 'morosoSince']);
        }
        // Activar o desactivar a un usuario y cambiar su estado de pago son privilegios aparte (usuarios.estado, usuarios.pago)
        function stateRights() {
          return (request.resource.data.get('active', true) == resource.data.get('active', true) || pUsuariosEstado(condoId))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus', 'morosoSince']) || pUsuariosPago(condoId));
        }
        // Cada miembro lee su propia ficha (de ahi salen sus privilegios); las demas, con usuarios.ver
        allow read: if isMaster()
          || (isMember(condoId) && request.auth.uid == userId)
          || pUsuariosVer(condoId);
        allow create: if isMaster()
          || (validUser() && canCreateRole(condoId, request.resource.data.role)
              && (request.resource.data.get('privilegios', {}).size() == 0 || pUsuariosPrivilegios(condoId)));
        allow update: if isMaster()
          || (pUsuariosEditar(condoId) && validUser() && paymentByHand() && stateRights()
              && manageable(condoId, resource.data.role) && manageable(condoId, request.resource.data.role)
              && (!touchesPower() || (pUsuariosPrivilegios(condoId) && userId != request.auth.uid)));
        allow delete: if isMaster()
          || (pUsuariosEliminar(condoId) && manageable(condoId, resource.data.role) && userId != request.auth.uid);
      }

      match /visitas/{visitId} {
        // Un acceso temporal (varios dias) es un privilegio aparte del vecino (vecino.temporal)
        function residentVisitOk(c) {
          return request.resource.data.get('visitType', null) != 'temporal' || pVecinoTemporal(c);
        }
        allow read: if isMaster()
          || pVisitasVer(condoId)
          || (isResident(condoId) && pVecinoHistorial(condoId) && isOwner());
        allow create: if isMaster()
          || pVisitasCrear(condoId)
          || (isResident(condoId) && pVecinoVisitas(condoId) && willOwn(condoId) && residentVisitOk(condoId));
        allow update: if isMaster()
          || pVisitasEditar(condoId)
          || (pGaritaIngreso(condoId) && onlyChanges(['status', 'enteredAt']))
          || (isResident(condoId) && pVecinoVisitas(condoId) && isOwner() && willOwn(condoId) && residentVisitOk(condoId));
        // Al eliminar un usuario se borran tambien sus visitas y vehiculos (usuarios.eliminar solo sirve para eso)
        allow delete: if isMaster()
          || pVisitasEliminar(condoId)
          || (pUsuariosEliminar(condoId) && ownerGone(resource.data.userId))
          || (isResident(condoId) && pVecinoVisitas(condoId) && isOwner());
      }

      match /vehiculos/{vehicleId} {
        allow read: if isMaster()
          || pVehiculosVer(condoId)
          || (isResident(condoId) && pVecinoVehiculos(condoId) && isOwner());
        allow create: if isMaster()
          || (pVehiculosCrear(condoId) && request.resource.data.condominioId == condoId)
          || (isResident(condoId) && pVecinoVehiculos(condoId) && willOwn(condoId));
        allow update: if isMaster() || pVehiculosEditar(condoId);
        allow delete: if isMaster()
          || pVehiculosEliminar(condoId)
          || (pUsuariosEliminar(condoId) && ownerGone(resource.data.userId))
          || (isResident(condoId) && pVecinoVehiculosQuitar(condoId) && isOwner());
      }

      match /mensajes/{msgId} {
        allow read: if isMaster()
          || pMensajesHistorial(condoId)
          || (pMensajesRecibir(condoId) && resource.data.toRole in ['all', memberRole(condoId)]);
        allow create: if isMaster()
          || (pMensajesEnviar(condoId) && request.resource.data.condominioId == condoId);
        allow update: if isMaster()
          || pMensajesEnviar(condoId)
          || (pMensajesRecibir(condoId)
              && notAuditor(condoId)
              && resource.data.toRole in ['all', memberRole(condoId)]
              && onlyChanges(['read']));
        allow delete: if isMaster() || pMensajesEliminar(condoId);
      }

      match /camera_logs/{logId} {
        allow read: if isMaster() || pGaritaCamara(condoId);
        allow create: if pGaritaIngreso(condoId) && request.resource.data.condominioId == condoId;
        allow update: if false;
        allow delete: if isMaster() || pGaritaHistorialBorrar(condoId);
      }

      // ── Sistema Financiero (OIKOS, ver finanzas-sync.js) ──
      // Lo edita quien tiene finanzas.usar; el master y quien solo tiene finanzas.ver leen. Nunca se borra:
      // OIKOS anula con deleted:true para que la anulacion llegue a todos los equipos.
      function canReadFinance() { return isMaster() || pFinanzasVer(condoId); }
      function validFinanceItem() {
        return 'id' in request.resource.data
          && (!('receiptImg' in request.resource.data)
              || request.resource.data.receiptImg == null
              || (request.resource.data.receiptImg is string && request.resource.data.receiptImg.size() < 900000));
      }
      // Campos que cambia cada operacion (para exigir el privilegio de cada una)
      function finChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // Datos financieros del residente (el nombre, la casa y el telefono viven en usuarios)
      function residentRights() {
        return (!finChanged().hasAny(['status', 'closedAt', 'closeReason', 'closeNotes', 'reactivatedAt', 'feeFrom']) || pFinanzasResidentesFiniquitar(condoId))
          && (!finChanged().hasAny(['deleted', 'deleted_at']) || pFinanzasResidentesEliminar(condoId))
          && (finChanged().hasOnly(['status', 'closedAt', 'closeReason', 'closeNotes', 'reactivatedAt', 'feeFrom', 'deleted', 'deleted_at', 'updated_at', 'created_at', 'createdAt'])
              || pFinanzasResidentesEditar(condoId));
      }
      match /finanzas_residentes/{docId} {
        allow read: if canReadFinance();
        // El residente nuevo con sus datos lo crea quien puede registrar residentes; el registro minimo (id, feeFrom) que
        // OIKOS crea solo al abrir para un vecino sin datos financieros lo admite cualquiera que use el Sistema Financiero
        allow create: if validFinanceItem()
          && (pFinanzasResidentesCrear(condoId)
              || (pFinanzasUsar(condoId) && request.resource.data.keys().hasOnly(['id', 'feeFrom', 'updated_at', 'created_at', 'createdAt'])));
        // Un "toque" (solo la fecha de modificacion, y createdAt que OIKOS copia del vecino) lo hace OIKOS al operar
        allow update: if pFinanzasUsar(condoId) && validFinanceItem()
          && (finChanged().hasOnly(['updated_at', 'created_at', 'createdAt']) || residentRights());
        allow delete: if false;
      }
      // Movimientos: cada tipo tiene su privilegio (cargo, pago, egreso) y anular es otro aparte
      function movementCreateOk() {
        return (request.resource.data.get('type', '') == 'income' && pFinanzasPagosRegistrar(condoId))
          || (request.resource.data.get('type', '') == 'expense'
              && (pFinanzasEgresosRegistrar(condoId)
                  // OIKOS asienta el saldo inicial adeudado al registrar un residente nuevo
                  || (request.resource.data.get('concept', '') == 'Saldo Inicial Adeudado' && pFinanzasResidentesCrear(condoId))))
          // Las cuotas automaticas (auto:true) las genera quien tiene "cuota del mes"; las manuales (boton Cuota del mes,
          // meses de un residente o cargo con concepto de cuota) llevan manual:true y no se distinguen entre si en las reglas
          || (request.resource.data.get('type', '') == 'charge'
              && ((request.resource.data.get('kind', '') == 'fee'
                    && (pFinanzasCuotasMes(condoId)
                        || (request.resource.data.get('auto', false) != true && (pFinanzasCuotasMeses(condoId) || pFinanzasCargosCrear(condoId)))))
                  || (request.resource.data.get('kind', '') == 'extra' && pFinanzasCargosCrear(condoId))));
      }
      // "Deshacer" (Ctrl+Z en OIKOS) solo alcanza lo hecho hace poco: la pila de deshacer vive en la memoria de la pagina.
      // Sin este limite, quien tiene "deshacer" anularia cualquier movimiento aunque no tenga "anular pagos". La fecha la
      // sella el cliente, pero al anular o devolver solo se pueden tocar los campos de la anulacion, no la fecha de alta.
      function undoWindow(field) {
        return request.time < timestamp.value(resource.data.get(field, '1970-01-01T00:00:00Z')) + duration.value(2, 'h');
      }
      function movementUpdateOk() {
        return finChanged().hasOnly(['updated_at'])
          || (resource.data.get('type', '') == 'charge' && finChanged().hasOnly(['period', 'kind', 'updated_at']))
          // Anular: el mismo documento con deleted:true (nunca se borra)
          || (request.resource.data.get('deleted', false) == true && resource.data.get('deleted', false) != true
              && finChanged().hasOnly(['deleted', 'deleted_at', 'deleted_reason', 'updated_at'])
              && ((pFinanzasDeshacer(condoId) && undoWindow('created_at'))
                  || (resource.data.get('type', '') == 'income' && pFinanzasPagosAnular(condoId))
                  || (resource.data.get('type', '') == 'expense' && pFinanzasEgresosAnular(condoId))
                  || (resource.data.get('type', '') == 'charge'
                      && (pFinanzasCargosAnular(condoId) || (resource.data.get('kind', '') == 'fee' && pFinanzasCuotasCorregir(condoId))))))
          // Devolver una anulacion es "deshacer"
          || (resource.data.get('deleted', false) == true && request.resource.data.get('deleted', false) != true
              && finChanged().hasOnly(['deleted', 'deleted_at', 'deleted_reason', 'updated_at'])
              && pFinanzasDeshacer(condoId) && undoWindow('updated_at'));
      }
      match /finanzas_movimientos/{docId} {
        allow read: if canReadFinance();
        allow create: if validFinanceItem() && movementCreateOk();
        allow update: if pFinanzasUsar(condoId) && validFinanceItem() && movementUpdateOk();
        allow delete: if false;
      }
      // ── Rondas: SISDEL RONDIN sobre la base de SISDEL (ver rondin/js/sisdel-api.js) ──
      // Los campos conservan el formato de RONDIN: company_id = condominio, guard_id/user_id = usuario.
      function sameCompany() { return request.resource.data.company_id == condoId; }
      function sameCondo() { return request.resource.data.condominioId == condoId; }
      function canSeeRondas() { return canManageRondas(condoId) || pRondasVer(condoId); }
      function patrols() { return isPatroller(condoId) || canManageRondas(condoId); }
      function setsOwn(field) { return request.resource.data.get(field, '') == request.auth.uid; }
      function wasOwn(field) { return resource.data.get(field, '') == request.auth.uid; }
      function keeps(field) { return request.resource.data.get(field, null) == resource.data.get(field, null); }

      // Configuracion de RONDIN (boton de panico de vecinos, pais, logo): la leen todos los del condominio
      match /rondas_config/{docId} {
        allow read: if isMaster() || isMember(condoId);
        allow create, update: if (isMaster() || pRondasAjustesPanicovecinos(condoId)) && docId == 'general' && sameCompany();
        allow delete: if false;
      }
      // Expediente del guardia o supervisor (DPI, tipo de sangre, supervisor asignado); el resto vive en usuarios.
      // El supervisor asignado es un privilegio (rondas.supervisores_asignar) y el expediente, otro (guardias.crear)
      match /rondas_personal/{userId} {
        allow read: if canSeeRondas();
        allow create: if (isMaster() || pGuardiasCrear(condoId) || pUsuariosCrear(condoId)) && sameCompany() && request.resource.data.id == userId;
        allow update: if sameCompany() && request.resource.data.id == userId
          && (isMaster()
              || (onlyChanges(['supervisor_id', 'updated_at']) ? pRondasSupervisoresAsignar(condoId) : (pGuardiasCrear(condoId) || pUsuariosEditar(condoId))));
        allow delete: if pUsuariosEliminar(condoId) && ownerGone(userId);
      }
      // Rutas con sus puntos de control: las ven quienes patrullan. Los puntos van dentro de la ruta: se distingue
      // agregar (hay mas), quitar (hay menos) o renombrar (los mismos) por el cambio en su cantidad
      function routeUpdateOk() {
        return finChanged().hasOnly(['checkpoints', 'updated_at'])
          ? (request.resource.data.get('checkpoints', []).size() > resource.data.get('checkpoints', []).size() ? pRondasPuntosCrear(condoId)
              : (request.resource.data.get('checkpoints', []).size() < resource.data.get('checkpoints', []).size() ? pRondasPuntosEliminar(condoId)
                  : pRondasPuntosEditar(condoId)))
          : ((finChanged().hasOnly(['status', 'updated_at']) && request.resource.data.get('status', '') == 'INACTIVE') ? pRondasRutasEliminar(condoId)
              : pRondasRutasCrear(condoId));
      }
      match /rondas_rutas/{routeId} {
        allow read: if isMaster() || pRondasRutasVer(condoId) || isPatroller(condoId);
        allow create: if (isMaster() || pRondasRutasCrear(condoId)) && sameCompany();
        allow update: if sameCompany() && (isMaster() || routeUpdateOk());
        allow delete: if isMaster() || pRondasRutasEliminar(condoId);
      }
      // Que guardia patrulla que ruta y en que fechas
      match /rondas_asignaciones/{assignmentId} {
        allow read: if isMaster() || pRondasAsignacionesVer(condoId) || (isPatroller(condoId) && wasOwn('guard_id'));
        allow create: if (isMaster() || pRondasAsignacionesCrear(condoId)) && sameCompany();
        allow update: if (isMaster() || pRondasAsignacionesEditar(condoId)) && sameCompany();
        allow delete: if isMaster() || pRondasAsignacionesEliminar(condoId);
      }
      // Turnos y rondas: cada guardia escribe los suyos (iniciar, marcar y terminar son privilegios aparte);
      // el supervisor tambien puede crearlos o cerrarlos
      match /rondas_turnos/{shiftId} {
        allow read: if canSeeRondas() || (isPatroller(condoId) && wasOwn('guard_id'));
        allow create: if sameCompany() && ((isPatroller(condoId) && setsOwn('guard_id') && pRondasPatrullaIniciar(condoId)) || canManageRondas(condoId));
        allow update: if sameCompany() && keeps('guard_id')
          && ((isPatroller(condoId) && wasOwn('guard_id')
                && (request.resource.data.get('status', '') == 'COMPLETED' ? pRondasPatrullaTerminar(condoId) : pRondasPatrullaIniciar(condoId)))
              || canManageRondas(condoId));
        allow delete: if false;
      }
      match /rondas_rondas/{roundId} {
        allow read: if canSeeRondas() || (isPatroller(condoId) && wasOwn('guard_id'));
        allow create: if isPatroller(condoId) && pRondasPatrullaIniciar(condoId) && sameCompany() && setsOwn('guard_id') && request.resource.data.status == 'IN_PROGRESS';
        allow update: if sameCompany() && keeps('guard_id')
          && ((isPatroller(condoId) && wasOwn('guard_id') && (pRondasPatrullaMarcar(condoId) || pRondasPatrullaTerminar(condoId))) || canManageRondas(condoId));
        allow delete: if false;
      }
      // Visitas a puntos de control: registro de auditoria, no se editan ni se borran
      match /rondas_visitas/{visitId} {
        allow read: if isMaster() || pRondasRecorridosVer(condoId) || (isPatroller(condoId) && wasOwn('guard_id'));
        allow create: if isPatroller(condoId) && pRondasPatrullaMarcar(condoId) && sameCompany() && setsOwn('guard_id');
        allow update, delete: if false;
      }
      // Posicion actual de cada guardia (documento = su id) e historial de 30 dias: compartirla es un privilegio
      match /rondas_en_vivo/{userId} {
        allow read: if isMaster() || pRondasMonitoreoVer(condoId);
        allow create, update: if isPatroller(condoId) && pRondasPatrullaRastrear(condoId) && userId == request.auth.uid && setsOwn('user_id') && sameCompany();
        allow delete: if (isPatroller(condoId) && userId == request.auth.uid) || canManageRondas(condoId);
      }
      match /rondas_ubicaciones/{logId} {
        allow read: if isMaster() || pRondasMonitoreoHistorial(condoId);
        allow create: if isPatroller(condoId) && pRondasPatrullaRastrear(condoId) && sameCompany() && setsOwn('user_id');
        allow update, delete: if false;
      }
      // Incidentes: los reporta quien patrulla; los resuelve quien administra las rondas
      match /rondas_incidentes/{incidentId} {
        allow read: if isMaster() || pRondasIncidentesVer(condoId) || isResponder(condoId);
        allow create: if (pRondasIncidentesReportar(condoId) || canManageRondas(condoId)) && sameCompany() && setsOwn('reported_by') && request.resource.data.status == 'OPEN';
        allow update: if (isMaster() || pRondasIncidentesResolver(condoId)) && sameCompany() && keeps('reported_by');
        allow delete: if false;
      }
      // Alertas del panel de RONDIN (turno iniciado, punto visitado, incidente, abandono de turno...)
      match /rondas_alertas/{alertId} {
        allow read: if isMaster() || pRondasAlertasVer(condoId);
        allow create: if patrols() && sameCompany() && setsOwn('source_user_id') && request.resource.data.acknowledged == 0;
        allow update: if (isMaster() || pRondasAlertasAtender(condoId)) && onlyChanges(['acknowledged', 'acknowledged_by', 'acknowledged_at'])
          && request.resource.data.acknowledged_by == request.auth.uid;
        allow delete: if isMaster() || pRondasAlertasEliminar(condoId);
      }
      // Fotos (turnos e incidentes), comprimidas en el navegador: menos de ~900 KB
      match /rondas_fotos/{photoId} {
        allow read: if canSeeRondas() || wasOwn('by');
        allow create: if patrols() && sameCompany() && setsOwn('by')
          && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        allow update: if false;
        allow delete: if canManageRondas(condoId);
      }
      // Rondin Air: drones del condominio y su ultima telemetria
      match /rondas_drones/{droneId} {
        allow read: if isMaster() || pRondasDronesVer(condoId);
        allow create: if (isMaster() || pRondasDronesRegistrar(condoId)) && sameCompany();
        allow update: if (isMaster() || pRondasDronesOperar(condoId)) && sameCompany();
        allow delete: if isMaster() || pRondasDronesRegistrar(condoId);
      }

      // ── Alertas de panico (vecinos y guardias) ──
      // El vecino o guardia la crea a su nombre; admin, policia y supervisor la atienden;
      // el vecino puede cancelar la suya mientras siga activa. Nunca se borran.
      match /alertas_panico/{alertId} {
        allow read: if isMaster() || pPanicoVer(condoId)
          || (isResident(condoId) && resource.data.userId == request.auth.uid);
        allow create: if sameCondo() && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'ACTIVE'
          && pPanicoActivar(condoId)
          && ((isResident(condoId) && request.resource.data.source == 'vecino')
              || (!isResident(condoId) && request.resource.data.source == 'guardia'));
        allow update: if (isResponder(condoId)
              && onlyChanges(['status', 'attendedBy', 'attendedByName', 'attendedAt', 'resolvedBy', 'resolvedByName', 'resolvedAt', 'notes'])
              && ((request.resource.data.status == 'ATTENDED') || (request.resource.data.status == 'RESOLVED' && pPanicoResolver(condoId))))
          || (isResident(condoId) && pPanicoCancelar(condoId) && resource.data.userId == request.auth.uid && resource.data.status == 'ACTIVE'
              && onlyChanges(['status', 'cancelledAt']) && request.resource.data.status == 'CANCELLED');
        allow delete: if false;
      }
      // Contactos de emergencia del vecino (los avisa el boton de panico por WhatsApp)
      match /emergencia/{userId} {
        allow read: if isMaster() || pPanicoContactos(condoId)
          || (isResident(condoId) && pVecinoContactos(condoId) && request.auth.uid == userId);
        allow create, update: if ((isResident(condoId) && pVecinoContactos(condoId) && request.auth.uid == userId) || pUsuariosEmergencia(condoId))
          && request.resource.data.contacts is list && request.resource.data.contacts.size() <= 5;
        allow delete: if pUsuariosEliminar(condoId) && ownerGone(userId);
      }

      // Plantillas de privilegios propias del condominio (las del sistema viven en privilegios.js)
      match /plantillas_privilegios/{docId} {
        allow read: if isMaster() || pUsuariosPrivilegios(condoId);
        allow create, update: if (isMaster() || pPlantillasGestionar(condoId)) && request.resource.data.condominioId == condoId
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.claves is list && request.resource.data.claves.size() <= 300;
        allow delete: if isMaster() || pPlantillasGestionar(condoId);
      }

      // Configuracion: cuota y cobro, datos generales y conceptos son privilegios distintos; los contadores que cambia
      // operar (recibos, meses cobrados) los puede escribir quien use el Sistema Financiero
      function settingsRights() {
        return (!finChanged().hasAny(['fee', 'chargeDay', 'graceDays', 'feeMode']) || pFinanzasConfigCuota(condoId))
          && (!finChanged().hasAny(['currency', 'lang', 'name', 'theme']) || pFinanzasConfigGeneral(condoId))
          && (!finChanged().hasAny(['customIncomeConcepts']) || pFinanzasConfigConceptos(condoId) || pFinanzasCargosCrear(condoId))
          && (!finChanged().hasAny(['customExpenseConcepts']) || pFinanzasConfigConceptos(condoId) || pFinanzasEgresosRegistrar(condoId))
          && (finChanged().hasOnly(['fee', 'chargeDay', 'graceDays', 'feeMode', 'currency', 'lang', 'name', 'theme', 'customIncomeConcepts',
                                    'customExpenseConcepts', 'receiptCounter', 'chargedMonths', 'lastChargedMonth', 'updated_at', 'created_at'])
              || pFinanzasConfigGeneral(condoId));
      }
      match /finanzas_config/{docId} {
        allow read: if canReadFinance();
        allow create: if pFinanzasUsar(condoId) && docId == 'oikos_settings';
        allow update: if pFinanzasUsar(condoId) && docId == 'oikos_settings' && settingsRights();
        allow delete: if false;
      }
    }

    // ── Diagnostico de carga: cada usuario escribe sus tiempos, solo el master los lee ──
    match /_diag/{entryId} {
      allow read, delete: if isMaster();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['page', 'at', 'uid', 'role', 'condominioId', 'ms', 'net', 'ua'])
        && request.resource.data.page is string
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200;
      allow update: if false;
    }

  }
}
