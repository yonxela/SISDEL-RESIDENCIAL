{
  "rewrites": [
    {
      "source": "/api/lpr",
      "destination": "https://us-central1-sisdel-datacenter.cloudfunctions.net/anprWebhook"
    },
    {
      "source": "/api/anpr",
      "destination": "https://us-central1-sisdel-datacenter.cloudfunctions.net/anprWebhook"
    },
    {
      "source": "/api/lpr/:path*",
      "destination": "https://us-central1-sisdel-datacenter.cloudfunctions.net/anprWebhook"
    },
    {
      "source": "/LAPI/:path*",
      "destination": "https://us-central1-sisdel-datacenter.cloudfunctions.net/anprWebhook"
    },
    {
      "source": "/NotificationInfo/:path*",
      "destination": "https://us-central1-sisdel-datacenter.cloudfunctions.net/anprWebhook"
    }
  ]
}
